#!/usr/bin/env python3
"""indexor — manage a curated index of repositories (no dependencies).

The index lives in data/entries/ (one file per entry) and is published as a
Markdown file with
a table of contents and sections. New entries are submitted as issues; each
valid submission becomes a pull request and is published when it is merged.
See README.md.
"""
import argparse, datetime, glob, json, os, re, shutil, sys
from urllib.parse import urlparse

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG = os.path.join(ROOT, "indexor.config.json")
ENTRIES = os.path.join(ROOT, "data", "entries")
TEMPLATES = os.path.join(ROOT, ".github", "ISSUE_TEMPLATE")
SITE = os.path.join(ROOT, "tools", "site")

# Field labels of the submission issue form.
FIELDS = {
    "name": "Name",
    "url": "Repository URL",
    "section": "Section",
    "description": "Description",
    "owner": "Owner",
}
# Field labels of the removal issue form.
REMOVAL = {"url": "Repository to remove", "reason": "Reason"}
MAX = {"name": 60, "description": 200, "owner": 60, "reason": 300}


def load(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def write(path, text):
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def entry_files():
    return sorted(glob.glob(os.path.join(ENTRIES, "*.json")))


def load_entries():
    """Every entry is its own file, so parallel submissions never conflict."""
    return [load(f) for f in entry_files()]


def save_entry(e):
    slug = re.sub(r"[^a-z0-9]+", "-", e["url"].lower().split("://", 1)[-1]).strip("-")
    write(os.path.join(ENTRIES, slug + ".json"), json.dumps(e, ensure_ascii=False, indent=2) + "\n")


def one_line(text):
    return re.sub(r"\s+", " ", text or "").strip()


def md(text):
    """Escape third-party text for use inside a Markdown table."""
    return re.sub(r"([\\|\[\]<>`*_])", r"\\\1", one_line(text))


def quiet(text):
    """md() for bot comments: also stops submitted text from pinging @users."""
    return md(text).replace("@", "@\u200b")


def anchor(title):
    """The anchor GitHub generates for a heading."""
    s = re.sub(r"[^\w\- ]", "", title.strip().lower())
    return s.replace(" ", "-")


def normalize_url(url):
    return re.sub(r"\.git$", "", one_line(url).rstrip("/"))


def url_key(url):
    return normalize_url(url).lower()


# ---------------------------------------------------------------- validation

def validate_config(cfg):
    errors = []
    if not one_line(cfg.get("title", "")):
        errors.append("config: `title` is missing.")
    if not re.fullmatch(r"[\w\-./]+\.md", cfg.get("output", "")):
        errors.append("config: `output` must be the path of a .md file.")
    sections = cfg.get("sections") or []
    if not sections:
        errors.append("config: at least one section is required.")
    ids, names = set(), set()
    for s in sections:
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", s.get("id", "")):
            errors.append(f"config: invalid section id {s.get('id')!r} (lowercase letters, digits and hyphens).")
        if not one_line(s.get("name", "")):
            errors.append(f"config: section {s.get('id')!r} has no `name`.")
        if s.get("id") in ids or s.get("name") in names:
            errors.append(f"config: duplicate section {s.get('id')!r}.")
        ids.add(s.get("id")); names.add(s.get("name"))
    if not cfg.get("allowed_hosts"):
        errors.append("config: `allowed_hosts` cannot be empty.")
    return errors


def validate_entry(e, cfg, existing=()):
    """Return the list of problems with an entry (empty if valid)."""
    errors = []
    name, desc = one_line(e.get("name")), one_line(e.get("description"))
    if not name:
        errors.append("The **name** is missing.")
    elif len(name) > MAX["name"]:
        errors.append(f"The **name** is longer than {MAX['name']} characters.")
    if not desc:
        errors.append("The **description** is missing.")
    elif len(desc) > MAX["description"]:
        errors.append(f"The **description** is longer than {MAX['description']} characters.")
    if len(one_line(e.get("owner"))) > MAX["owner"]:
        errors.append(f"The **owner** is longer than {MAX['owner']} characters.")

    url = normalize_url(e.get("url", ""))
    p = urlparse(url)
    hosts = [h.lower() for h in cfg.get("allowed_hosts", [])]
    if p.scheme != "https" or not p.netloc:
        errors.append("The **URL** must start with `https://`.")
    elif p.netloc.lower() not in hosts:
        errors.append("The **URL** must be on: " + ", ".join(f"`{h}`" for h in hosts) + ".")
    elif not re.fullmatch(r"/[\w.\-]+/[\w.\-]+", p.path) or p.query or p.fragment:
        errors.append("The **URL** must point to the root of a repository (`https://host/owner/repo`).")
    elif any(url_key(x["url"]) == url_key(url) for x in existing):
        errors.append("That repository is **already in the index**.")

    if e.get("section") not in [s["id"] for s in cfg["sections"]]:
        errors.append("The **section** does not exist. Options: " + ", ".join(s["name"] for s in cfg["sections"]) + ".")
    return errors


# ------------------------------------------------------------------- issues

def issue_fields(body):
    """Parse an issue-form body: '### Label' blocks followed by a value."""
    fields = {}
    parts = re.split(r"^### +(.+?)\s*$", (body or "").replace("\r\n", "\n"), flags=re.M)
    for label, value in zip(parts[1::2], parts[2::2]):
        value = value.strip()
        fields[label.strip()] = "" if value == "_No response_" else value
    return fields


def entry_from_issue(event, cfg):
    """Return the entry proposed by the issue, or None if it is not a submission.

    Accepts a webhook event or a bare issue object from the API.
    """
    issue = event.get("issue", event)
    fields = issue_fields(issue.get("body"))
    if FIELDS["url"] not in fields or FIELDS["section"] not in fields:
        return None
    by_name = {s["name"]: s["id"] for s in cfg["sections"]}
    section = one_line(fields.get(FIELDS["section"]))
    return {
        "name": one_line(fields.get(FIELDS["name"])),
        "url": normalize_url(fields.get(FIELDS["url"], "")),
        "section": by_name.get(section, section),
        "description": one_line(fields.get(FIELDS["description"])),
        "owner": one_line(fields.get(FIELDS["owner"])),
        "submitted_by": issue["user"]["login"],
        "issue": issue["number"],
        "date": (issue.get("created_at") or datetime.date.today().isoformat())[:10],
    }


def summary(e, cfg):
    names = {s["id"]: s["name"] for s in cfg["sections"]}
    return "\n".join([
        "| Field | Value |", "|---|---|",
        f"| Name | {quiet(e['name'])} |",
        f"| URL | {quiet(e['url'])} |",
        f"| Section | {quiet(names.get(e['section'], e['section']))} |",
        f"| Description | {quiet(e['description'])} |",
        f"| Owner | {quiet(e['owner']) or '—'} |",
    ])


def removal_from_issue(event):
    """Return {url, reason} if the issue is a removal request, else None."""
    fields = issue_fields(event.get("issue", event).get("body"))
    if REMOVAL["url"] not in fields:
        return None
    return {"url": normalize_url(fields[REMOVAL["url"]]), "reason": one_line(fields.get(REMOVAL["reason"]))}


def kind_of(event, cfg):
    if removal_from_issue(event) is not None:
        return "removal"
    return "submission" if entry_from_issue(event, cfg) is not None else "unrelated"


def review_submission(event, cfg, write_changes):
    entries = load_entries()
    e = entry_from_issue(event, cfg)
    errors = validate_entry(e, cfg, entries)
    if errors:
        return errors, ""
    if write_changes:
        save_entry(e)
        generate(cfg, entries + [e])
    return [], ("### ✅ Valid submission\n\n" + summary(e, cfg)
                + "\n\nA pull request with this entry is open. The entry is published when a "
                  "maintainer merges it, and this issue is closed.\n")


def review_removal(event, cfg, write_changes):
    r = removal_from_issue(event)
    errors = []
    match = [f for f in entry_files() if url_key(load(f)["url"]) == url_key(r["url"])]
    if not match:
        errors.append("That repository is **not in the index**. Check the URL against the index.")
    if not r["reason"]:
        errors.append("The **reason** is missing.")
    elif len(r["reason"]) > MAX["reason"]:
        errors.append(f"The **reason** is longer than {MAX['reason']} characters.")
    if errors:
        return errors, ""
    e = load(match[0])
    if write_changes:
        os.remove(match[0])
        generate(cfg, load_entries())
    return [], (f"### ✅ Valid removal request\n\n**{quiet(e['name'])}** ({quiet(e['url'])}) is in the index.\n\n"
                "A pull request that removes it is open. The entry is removed when a "
                "maintainer merges it, and this issue is closed.\n")


def cmd_review(a):
    """Validate a submission or removal issue. Prints: unrelated | valid | invalid.

    With --write, a valid request is also applied and the index regenerated.
    """
    cfg, event = load(CONFIG), load(a.issue)
    kind = kind_of(event, cfg)
    if kind == "unrelated":
        print("unrelated"); return 0
    review = review_removal if kind == "removal" else review_submission
    errors, report = review(event, cfg, a.write)
    if errors:
        report = ("### ❌ This request needs changes\n\n"
                  + "\n".join(f"- {x}" for x in errors)
                  + "\n\nEdit the issue to fix it: it is validated again automatically.\n")
    if a.report:
        write(a.report, report)
    print("invalid" if errors else "valid")
    return 0


def cmd_kind(a):
    """Print the kind of request an issue is: submission | removal | unrelated."""
    print(kind_of(load(a.issue), load(CONFIG)))
    return 0


def cmd_title(a):
    """Print the pull request title for a submission or removal issue."""
    cfg, event = load(CONFIG), load(a.issue)
    r = removal_from_issue(event)
    if r is not None:
        names = [e["name"] for e in load_entries() if url_key(e["url"]) == url_key(r["url"])]
        print(f"Remove {quiet(names[0] if names else r['url'])} from the index")
    else:
        print(f"Add {quiet(entry_from_issue(event, cfg)['name'])} to the index")
    return 0


# ---------------------------------------------------------------- generation

def owner_md(o):
    o = one_line(o)
    if re.fullmatch(r"@?[A-Za-z0-9][A-Za-z0-9-]{0,38}", o):
        return f"[@{o.lstrip('@')}](https://github.com/{o.lstrip('@')})"
    return md(o) or "—"


def render(cfg, entries):
    n = len(entries)
    L = [f"# {cfg['title']}", ""]
    if cfg.get("description"):
        L += [cfg["description"], ""]
    L += ["<!-- Generated by tools/indexor — do not edit by hand. -->", "",
          f"**{n}** {'repository' if n == 1 else 'repositories'}. "
          "[Add one](../../issues/new?template=submission.yml) or "
          "[request a removal](../../issues/new?template=removal.yml).", "",
          "## Contents", ""]
    by = {s["id"]: sorted((e for e in entries if e["section"] == s["id"]),
                          key=lambda e: e["name"].lower()) for s in cfg["sections"]}
    for s in cfg["sections"]:
        L.append(f"- [{s['name']}](#{anchor(s['name'])}) ({len(by[s['id']])})")
    for s in cfg["sections"]:
        L += ["", f"## {s['name']}", ""]
        if s.get("description"):
            L += [s["description"], ""]
        if not by[s["id"]]:
            L.append("_No repositories in this section yet._")
            continue
        L += ["| Repository | Description | Owner |", "|---|---|---|"]
        for e in by[s["id"]]:
            L.append(f"| [{md(e['name'])}]({e['url']}) | {md(e['description'])} | {owner_md(e.get('owner'))} |")
    return "\n".join(L) + "\n"


def generate(cfg, entries):
    write(os.path.join(ROOT, cfg["output"]), render(cfg, entries))


def render_template(cfg):
    q = lambda s: json.dumps(s, ensure_ascii=False)  # a JSON string is valid YAML
    options = "\n".join(f"        - {q(s['name'])}" for s in cfg["sections"])
    return f"""# Generated by `python3 tools/indexor build` — do not edit by hand.
name: Add to the index
description: Ask for a repository to be added to the index.
title: "[Add] <repository name>"
labels: [submission]
body:
  - type: markdown
    attributes:
      value: Fill in the form. It is validated automatically and published once a maintainer merges it.
  - type: input
    id: name
    attributes:
      label: {q(FIELDS['name'])}
      description: How it will be shown in the index (max. {MAX['name']} characters).
    validations:
      required: true
  - type: input
    id: url
    attributes:
      label: {q(FIELDS['url'])}
      placeholder: https://{cfg['allowed_hosts'][0]}/owner/repo
    validations:
      required: true
  - type: dropdown
    id: section
    attributes:
      label: {q(FIELDS['section'])}
      options:
{options}
    validations:
      required: true
  - type: textarea
    id: description
    attributes:
      label: {q(FIELDS['description'])}
      description: One line on what it is and what it is for (max. {MAX['description']} characters).
    validations:
      required: true
  - type: input
    id: owner
    attributes:
      label: {q(FIELDS['owner'])}
      description: GitHub user or team to contact about it (optional).
"""


def render_removal_template(cfg):
    q = lambda s: json.dumps(s, ensure_ascii=False)
    return f"""# Generated by `python3 tools/indexor build` — do not edit by hand.
name: Remove from the index
description: Ask for a repository to be removed from the index.
title: "[Remove] <repository name>"
labels: [removal]
body:
  - type: markdown
    attributes:
      value: The entry is removed once a maintainer merges the pull request this opens.
  - type: input
    id: url
    attributes:
      label: {q(REMOVAL['url'])}
      description: The repository URL exactly as it appears in the index.
      placeholder: https://{cfg['allowed_hosts'][0]}/owner/repo
    validations:
      required: true
  - type: textarea
    id: reason
    attributes:
      label: {q(REMOVAL['reason'])}
      description: Why it should be removed (max. {MAX['reason']} characters).
    validations:
      required: true
"""


def generated_files(cfg, entries):
    return {os.path.join(ROOT, cfg["output"]): render(cfg, entries),
            os.path.join(TEMPLATES, "submission.yml"): render_template(cfg),
            os.path.join(TEMPLATES, "removal.yml"): render_removal_template(cfg)}


def cmd_build(a):
    cfg = load(CONFIG)
    for path, text in generated_files(cfg, load_entries()).items():
        write(path, text)
    print(f"Generated {cfg['output']} and the issue forms")
    return 0


def cmd_lint(a):
    cfg = load(CONFIG)
    errors = validate_config(cfg)
    entries = load_entries() if not errors else []
    for i, e in enumerate(entries):
        errors += [f"entry {i + 1} ({e.get('name')!r}): {x}"
                   for x in validate_entry(e, cfg, entries[:i])]
    if not errors:
        for path, expected in generated_files(cfg, entries).items():
            actual = open(path, encoding="utf-8").read() if os.path.exists(path) else ""
            if actual != expected:
                errors.append(f"{os.path.relpath(path, ROOT)} is out of date: run `python3 tools/indexor build`.")
    for x in errors:
        print(f"::error::{x}" if os.environ.get("GITHUB_ACTIONS") else f"ERROR: {x}")
    if not errors:
        print(f"OK: {len(entries)} entries, {len(cfg['sections'])} sections.")
    return 1 if errors else 0


def cmd_add(a):
    cfg, entries = load(CONFIG), load_entries()
    e = {"name": one_line(a.name), "url": normalize_url(a.url), "section": a.section,
         "description": one_line(a.description), "owner": one_line(a.owner),
         "date": datetime.date.today().isoformat()}
    errors = validate_entry(e, cfg, entries)
    if errors:
        print("\n".join(errors), file=sys.stderr); return 1
    save_entry(e)
    generate(cfg, entries + [e])
    print(f"Added: {e['name']}")
    return 0


def cmd_site(a):
    cfg, entries = load(CONFIG), load_entries()
    dest = os.path.abspath(a.dest)
    shutil.copytree(SITE, dest, dirs_exist_ok=True)
    public = {"title": cfg["title"], "description": cfg.get("description", ""),
              "repo": os.environ.get("GITHUB_REPOSITORY", ""),
              "sections": cfg["sections"],
              "entries": [{k: e.get(k, "") for k in ("name", "url", "section", "description", "owner", "date")}
                          for e in entries]}
    write(os.path.join(dest, "index.json"), json.dumps(public, ensure_ascii=False))
    print(f"Site generated in {dest}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="indexor", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("build", help="regenerate the index .md and the submission form").set_defaults(f=cmd_build)
    sub.add_parser("lint", help="validate config, entries and generated files").set_defaults(f=cmd_lint)
    s = sub.add_parser("add", help="add an entry by hand (no issue)")
    for field in ("name", "url", "section", "description"):
        s.add_argument(f"--{field}", required=True)
    s.add_argument("--owner", default="")
    s.set_defaults(f=cmd_add)
    s = sub.add_parser("site", help="generate the static site")
    s.add_argument("dest", nargs="?", default="_site"); s.set_defaults(f=cmd_site)
    s = sub.add_parser("review", help="(CI) validate a submission or removal issue")
    s.add_argument("issue"); s.add_argument("--report")
    s.add_argument("--write", action="store_true"); s.set_defaults(f=cmd_review)
    s = sub.add_parser("kind", help="(CI) submission, removal or unrelated")
    s.add_argument("issue"); s.set_defaults(f=cmd_kind)
    s = sub.add_parser("title", help="(CI) pull request title for a request")
    s.add_argument("issue"); s.set_defaults(f=cmd_title)
    a = p.parse_args()
    sys.exit(a.f(a))


if __name__ == "__main__":
    main()
